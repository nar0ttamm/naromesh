# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard auth
ADMIN_PASSWORD=

# fal.ai
FAL_KEY=

# Meta / Instagram Graph API
META_ACCESS_TOKEN=
IG_USER_ID=

# Optional: OpenAI for caption generation
OPENAI_API_KEY=

# Set to "true" to skip fal/Meta calls during testing
MOCK_MODE=false

# GitHub (optional — needed for "Run Pipeline" button in dashboard)
# Token needs: repo + workflow scopes
GITHUB_TOKEN=
# e.g. "myuser/instagram-money"
GITHUB_REPO=
